# Copy this file to `.env` and fill in the values.

# Prisma / SQLite — local database file (default is fine)
DATABASE_URL="file:./dev.db"

# Adzuna job-search API — OPTIONAL. Unlocks the "Adzuna" source in Live Jobs.
# The app runs fine without it; leave blank to skip that source.
# Get free credentials at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
